{
  "expo": {
    "name": "MacroManiacs",
    "slug": "macromaniacs",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.macromaniacs.app"
    },
    "android": {
      "package": "com.macromaniacs.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#9D52DE"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "100f521c-e0e3-46df-907f-02011e9c874e"
      }
    },
    "owner": "andersonskwrs-team"
  }
}
