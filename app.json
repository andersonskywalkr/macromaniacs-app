{
  "expo": {
    "name": "MacroManiacs",
    "slug": "macromaniacs",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.macromaniacs.app"
    },
    "android": {
      "package": "com.macromaniacs.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      "expo-font",
      "expo-sqlite"
    ]
  }
}
