# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commitar o .env de verdade (ver seção 84/108 do documento de arquitetura).

# true = usa dados fake (src/mocks), sem precisar do backend rodando
# false = chama a API real do NestJS
EXPO_PUBLIC_USE_MOCK=true

# false = cadastro/login/sessão usam o backend real, mesmo que os demais
# módulos continuem em mock enquanto seus endpoints não existem.
EXPO_PUBLIC_USE_AUTH_MOCK=false

# URL sem /api/v1 no final. Escolha conforme onde o app estiver rodando:
# Android Emulator: http://10.0.2.2:3000
# iOS Simulator/Web: http://localhost:3000
# Celular físico: http://IP_DA_SUA_MAQUINA:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# true = depois de login/onboarding, mostra a tela "em construção" no lugar
# do app de verdade (usado pra apresentação, enquanto Home/Refeições/Grupo/
# Perfil ainda são mock). false = mostra o AppTabs normalmente.
EXPO_PUBLIC_SHOW_MAINTENANCE_SCREEN=true

# URL da landing page oficial, aberta pelo botão da tela "em construção".
EXPO_PUBLIC_LANDING_PAGE_URL=
