# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commitar o .env de verdade (ver seção 84/108 do documento de arquitetura).

# Chaves de troca mock/real. Combinações:
#   USE_MOCK=true  + USE_AUTH_MOCK=true  -> TUDO mock, sem chamar o backend (qualquer
#                                           usuário/senha entra; para testar telas).
#   USE_MOCK=true  + USE_AUTH_MOCK=false -> login, cadastro e perfil REAIS; alimentos,
#                                           refeições, progresso, gamificação e grupos em
#                                           mock (mistura dados reais e de mock).
#   USE_MOCK=false + USE_AUTH_MOCK=false -> TUDO real (precisa de EXPO_PUBLIC_API_URL).
#   USE_MOCK=false + USE_AUTH_MOCK=true  -> não usar (autenticação mock + resto real).
# Se USE_AUTH_MOCK não for definida, ela acompanha USE_MOCK.
EXPO_PUBLIC_USE_MOCK=true
EXPO_PUBLIC_USE_AUTH_MOCK=true

# URL do backend SEM /v1 no final (o app já coloca /v1 em todas as rotas).
# Obrigatória quando USE_MOCK ou USE_AUTH_MOCK for false; sem ela o app não inicia.
#   Backend publicado: https://URL-DO-BACKEND-PUBLICADO (confirme com o time de backend)
#   Android Emulator:  http://10.0.2.2:3000
#   iOS Simulator/Web: http://localhost:3000
#   Celular físico:    http://IP_DA_SUA_MAQUINA:3000
# Estas variáveis EXPO_PUBLIC_* são gravadas no app na hora do build: para o APK,
# elas ficam no eas.json (perfis preview-mock e preview-real), não neste arquivo.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Abas que ainda mostram a tela "em construção" no lugar da tela real
# (apresentação). Nomes separados por vírgula: home, meals, group.
# Vazio ou ausente = nenhuma aba em manutenção (padrão atual: todas as abas estão
# prontas). Vale só para o desenvolvimento local: nos builds do EAS (eas.json) a
# variável não é definida, porque o EAS não aceita valor vazio.
# A aba Perfil nunca entra aqui.
EXPO_PUBLIC_MAINTENANCE_TABS=

# URL da landing page oficial, aberta pelo botão da tela "em construção".
EXPO_PUBLIC_LANDING_PAGE_URL=https://macromaniacs-landingpage.vercel.app/
