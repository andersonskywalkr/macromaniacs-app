{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_USE_AUTH_MOCK": "false",
        "EXPO_PUBLIC_LANDING_PAGE_URL": "https://macromaniacs-landingpage.vercel.app/"
      }
    },
    "preview-mock": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "true",
        "EXPO_PUBLIC_USE_AUTH_MOCK": "true",
        "EXPO_PUBLIC_LANDING_PAGE_URL": "https://macromaniacs-landingpage.vercel.app/"
      }
    },
    "preview-real": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_USE_AUTH_MOCK": "false",
        "EXPO_PUBLIC_LANDING_PAGE_URL": "https://macromaniacs-landingpage.vercel.app/"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_USE_AUTH_MOCK": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
